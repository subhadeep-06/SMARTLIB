# ==============================================================================
# SMARTLIB — Environment Configuration Example (Placeholders Only)
# Never commit real secrets to source control.
# ==============================================================================

# MongoDB Atlas Configuration (Spring Boot Backend)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartlib?retryWrites=true&w=majority"
MONGODB_DATABASE="smartlib"

# JWT Security Configuration
JWT_SECRET="replace-with-256-bit-base64-secret-key"
JWT_ACCESS_EXPIRATION="900000"
JWT_REFRESH_EXPIRATION="604800000"

# CORS & Hosting
FRONTEND_URL="https://smartlib.vercel.app"
PORT="8080"
APP_ENV="development"

# Optional SMTP Mail Integration (Development fallback active when blank)
MAIL_HOST="smtp.example.edu"
MAIL_PORT="587"
MAIL_USERNAME="library-noreply@example.edu"
MAIL_PASSWORD="replace-with-smtp-password"

# Frontend (Vite / Vercel)
VITE_API_BASE_URL="/api"

# Runtime Platform Vars
APP_URL="MY_APP_URL"
